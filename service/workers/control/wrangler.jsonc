{
  // The configuration the tests and the build run against. `agents-city infra
  // deploy` writes the real one, with the operator's own names and ids.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-city-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "sandbox"
  },
  "services": [
    {
      "binding": "ROADS_BUS",
      "service": "agents-city-relay"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL",
      "database_name": "agents-city-control",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations/control-plane"
    }
  ]
}
