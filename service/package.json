{
  "name": "agents-city-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Agents City service: accounts, organizations and the end-to-end encrypted relay, to deploy on your own Cloudflare account",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "npm run types && tsc -p tsconfig.json && tsc -p packages/connect-client/tsconfig.json && tsc -p workers/control/tsconfig.json && tsc -p workers/relay/tsconfig.json && tsc -p workers/transparency-witness/tsconfig.json",
    "test": "npm run test:contracts && npm run test:hybrid && npm run test:ratchet && npm run test:relay && npm run test:witness",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:hybrid": "cargo test --locked --offline --manifest-path packages/hybrid-crypto/Cargo.toml",
    "test:ratchet": "vitest run --config vitest.ratchet.config.ts --maxWorkers=1",
    "test:relay": "vitest run --config workers/relay/vitest.config.ts --maxWorkers=1 --no-isolate",
    "test:witness": "vitest run --config workers/transparency-witness/vitest.config.ts --maxWorkers=1 --no-isolate",
    "build:workers": "node scripts/build-workers.mjs",
    "export:client": "node scripts/export-public-connect-client.mjs --target ..",
    "fuzz:hybrid:check": "node scripts/run-hybrid-fuzz.mjs --check",
    "fuzz:hybrid": "node scripts/run-hybrid-fuzz.mjs --run",
    "fuzz:protocol:build": "esbuild fuzz/protocol/fuzz-target.ts --bundle --platform=node --target=node22 --format=esm --outfile=.fuzz-build/protocol.mjs",
    "fuzz:protocol:regression": "npm run fuzz:protocol:build && jazzer .fuzz-build/protocol.mjs fuzz/protocol/corpus --sync --mode=regression",
    "types": "wrangler types worker-configuration.d.ts --config=workers/relay/wrangler.jsonc --env-interface=RelayEnv"
  },
  "dependencies": {
    "@kinsh/vodozemac-wasm": "0.4.2",
    "@napi-rs/keyring": "1.3.0",
    "@simplewebauthn/server": "^13.3.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "^5.20260821.1",
    "@jazzer.js/core": "4.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1",
    "ws": "^8.21.0"
  }
}
