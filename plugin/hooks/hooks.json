{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" notice-on-pr || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" notice-on-pr",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" digging || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" digging",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" ask-the-house || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" ask-the-house",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" activity SessionStart || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" activity SessionStart",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" notice-pending || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" notice-pending",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" activity UserPromptSubmit || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" activity UserPromptSubmit",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" who-does-this-concern || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" who-does-this-concern",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" activity Stop || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" activity Stop",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" notice-on-stop || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" notice-on-stop",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" tokens || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" tokens",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" growth || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" growth",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" activity SessionEnd || python \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" activity SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
