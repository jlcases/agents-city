{
  "protocol": "agents-city-multiplexer/1",
  "_": [
    "Every command this product sends to the window server it runs agents in.",
    "",
    "It was spread over five files in three languages: Python asked for sessions",
    "one way, the terminal adapter another, and the session script had fifty-six",
    "of them inline. Nothing named the dependency, so 'can this run somewhere",
    "else' had no answer short of reading all of it.",
    "",
    "Here the knowledge is a table and the executors are dumb: multiplexor.py and",
    "multiplexor.ts interpolate <placeholders> and run. A second window server is",
    "a second block in this file, not an edit to any caller — which is the whole",
    "point, because tmux is the one dependency of this product with no answer on",
    "Windows.",
    "",
    "A verb absent from a backend is a capability that backend does not have, and",
    "the executors say so by name rather than failing somewhere further down."
  ],
  "default": "tmux",
  "backends": {
    "tmux": {
      "bin": "tmux",
      "detect": ["-V"],
      "exact": "=",
      "verbs": {
        "version": ["-V"],
        "sessions": ["ls", "-F", "#{session_name}"],
        "has-session": ["has-session", "-t", "<exact><session>"],
        "current-session": ["display-message", "-p", "#{session_name}"],
        "new-session": ["new-session", "-d", "-s", "<session>", "-c", "<cwd>", "-n", "<window>"],
        "kill-session": ["kill-session", "-t", "<session>"],
        "attach": ["attach-session", "-t", "<session>"],
        "windows": ["list-windows", "-t", "<exact><session>", "-F", "#{window_name}"],
        "new-window": ["new-window", "-t", "<session>", "-n", "<window>", "-c", "<cwd>"],
        "kill-window": ["kill-window", "-t", "<target>"],
        "select-window": ["select-window", "-t", "<target>"],
        "pane-state": [
          "list-panes",
          "-t",
          "<target>",
          "-F",
          "#{pane_dead}\t#{pane_current_command}"
        ],
        "capture": ["capture-pane", "-p", "-t", "<target>", "-S", "-<lines>"],
        "send-literal": ["send-keys", "-t", "<target>", "-l", "--", "<text>"],
        "send-enter": ["send-keys", "-t", "<target>", "Enter"],
        "load-buffer": ["load-buffer", "-b", "<buffer>", "-"],
        "paste-buffer": ["paste-buffer", "-d", "-p", "-r", "-b", "<buffer>", "-t", "<target>"],
        "set-option": ["set-option", "-t", "<session>", "<name>", "<value>"],
        "set-option-global": ["set-option", "-g", "<name>", "<value>"],
        "set-environment": ["set-environment", "-t", "<session>", "<name>", "<value>"]
      },
      "install": {
        "brew": "tmux",
        "apt-get": "tmux",
        "dnf": "tmux",
        "pacman": "tmux"
      }
    }
  }
}
